@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    var appName = "Тренувальник сольфеджіо";
}
<!doctype html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
@using System.Globalization

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="@Localizer["MetaDescription"]" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical"
          href="https://solfegio.azurewebsites.net@(Context.Request.Path)" />

    <link rel="sitemap"
          type="application/xml"
          title="Sitemap"
          href="/sitemap.xml" />

    <title>@ViewData["Title"] - @appName</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] - @appName" />
    <meta property="og:description" content="@Localizer["MetaDescription"]" />
    <meta property="og:url"
          content="https://solfegio.azurewebsites.net@(Context.Request.Path)" />
    <meta property="og:site_name" content="@appName" />
    <meta property="og:locale"
          content="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "uk" ? "uk_UA" : "en_US")" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Bootstrap & site CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark navbar-colored">
            <div class="container">
                <a class="navbar-brand ms-lg-5" asp-page="/Index">@Localizer["Title"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                        aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Create">>@Localizer["Build"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">>@Localizer["Recognise"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Melodies">@Localizer["Intervals"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Privacy">@Localizer["About"]</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="langMenu" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Мова
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="langMenu">
                                <li><a class="dropdown-item" href='@Url.Page("/SetLanguage", new { culture = "uk", returnUrl = Context.Request.Path + Context.Request.QueryString })'>UK</a></li>
                                <li><a class="dropdown-item" href='@Url.Page("/SetLanguage", new { culture = "en", returnUrl = Context.Request.Path + Context.Request.QueryString })'>EN</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebSite",
          "url": "https://solfegio.azurewebsites.net/",
          "name": "Solfegio",
        }
    </script>

    <div class="container-fluid">
        <main role="main" class="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted ">
        <div class="container">
            &copy; @DateTime.Now.Year - @appName
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
