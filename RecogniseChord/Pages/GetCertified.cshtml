@page
@model RecogniseChord.Pages.GetCertifiedModel
@using System.Globalization
@{
    ViewData["Title"] = Localizer["Certificates"];
}

<main id="certifiedQuiz"
      class="container py-4 text-center"
      data-next-url="@Url.Page("/Index", "QuizNext")"
      data-options-url="@Url.Page("/Index", "QuizOptions")"
      data-answer-url="@Url.Page("/Index", "QuizAnswer")"
      data-issue-url="@Url.Page("/GetCertified", "IssueCertificate")"
      data-lookup-url="@Url.Page("/VerifyCertificate", "Lookup")"
      data-authenticated="@Model.IsAuthenticated.ToString().ToLowerInvariant()"
      data-display-name="@Model.DisplayName"
      data-culture="@CultureInfo.CurrentUICulture.Name"
      data-seconds="@Localizer["Seconds"]"
      data-placeholder-count="@Localizer["ChooseCount"]"
      data-placeholder-type="@Localizer["ChooseType"]"
      data-placeholder-quality="@Localizer["ChooseQuality"]"
      data-error-options="@Localizer["ErrorOptions"]"
      data-error-next="@Localizer["ErrorNext"]"
      data-error-answer="@Localizer["ErrorAnswer"]"
      data-error-issue="@Localizer["ErrorIssue"]"
      data-label-chord="@Localizer["ChordProgress"]"
      data-label-correct="@Localizer["Correct"]"
      data-label-incorrect="@Localizer["Incorrect"]"
      data-label-time="@Localizer["Time"]"
      data-feedback-correct="@Localizer["FeedbackCorrect"]"
      data-feedback-timeout="@Localizer["FeedbackTimeout"]"
      data-feedback-incorrect="@Localizer["FeedbackIncorrect"]"
      data-feedback-answer="@Localizer["FeedbackAnswer"]"
      data-outcome-passed="@Localizer["OutcomePassed"]"
      data-outcome-failed="@Localizer["OutcomeFailed"]"
      data-finished="@Localizer["QuizFinished"]"
    data-level-easy="@Localizer["Easy"]"
    data-level-base="@Localizer["Base"]"
    data-level-intermediate="@Localizer["Intermediate"]"
    data-level-advanced="@Localizer["Advanced"]"
    data-level-expert="@Localizer["Expert"]"
      data-verification-number="@Localizer["VerificationNumber"]"
      data-verify-title="@Localizer["VerifyCertificateTitle"]"
      data-verify="@Localizer["VerifyCertificate"]"
      data-verify-invalid="@Localizer["CertificateNotFound"]"
      data-verify-error="@Localizer["VerificationError"]"
      data-verify-name="@Localizer["CertificateRecipient"]"
      data-verify-level="@Localizer["VerificationLevel"]"
      data-verify-score="@Localizer["Score"]"
      data-verify-date="@Localizer["IssuedOn"]">
    <h1 class="display-4">@Localizer["Certificates"]</h1>
    @if (!string.IsNullOrEmpty(Model.LoginError))
    {
        <p class="alert alert-danger" role="alert">@Localizer[Model.LoginError]</p>
    }
    <p>Запрошуємо здобути сертифікат, що засвідчує ваше вміння розпізнавати на слух акорди!</p>

    <!--КНОПКИ-->
    <div id="quizLevelPicker" class="my-4">
        <p>@Localizer["ChooseLevel"]</p>
        <div class="quiz-level-options">
            <div class="quiz-level-option">
                <!--EASY-->
                <div class="quiz-level-action">
                    <svg class="quiz-level-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                        <circle cx="24" cy="24" r="21" fill="#fff2cf" stroke="#976b32" stroke-width="2" />
                        <path d="M27 11v19.5a5.5 5.5 0 1 1-3-4.9V16l13-3v14.5a5.5 5.5 0 1 1-3-4.9V10z" fill="#976b32" />
                        <path d="M9 22h7M32 35h7" stroke="#c79743" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <button type="button" class="btn btn-primary" data-level="easy">@Localizer["Easy"]</button>
                </div>
                <p>@Localizer["EasyDescription"]</p>
            </div>
            <!--Base-->
            <div class="quiz-level-option">                
                <div class="quiz-level-action">
                    <svg class="quiz-level-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                        <circle cx="24" cy="24" r="21" fill="#fff2cf" stroke="#976b32" stroke-width="2" />
                        <path d="M11 17h25M10 22h26M10 27h26M11 32h25" stroke="#c79743" stroke-width="1.4" stroke-linecap="round" />
                        <path d="M18 11v15a4 4 0 1 1-2-3.5V13l9-2v12a4 4 0 1 1-2-3.5V12zM31 18v12a3.5 3.5 0 1 1-2-3.1V20z" fill="#976b32" />
                    </svg>
                    <button type="button" class="btn btn-primary" data-level="base">@Localizer["Base"]</button>
                </div>
                <p>@Localizer["BaseDescription"]</p>
            </div>
            <!--Intermediate-->
            <div class="quiz-level-option">                
                <div class="quiz-level-action">
                    <svg class="quiz-level-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                        <circle cx="24" cy="24" r="21" fill="#fff2cf" stroke="#976b32" stroke-width="2" />
                        <path d="M8 34 17 25 24 30 38 14" fill="none"
                              stroke="#976b32" stroke-width="3"
                              stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M30 14h8v8" fill="none"
                              stroke="#c79743" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <button type="button" class="btn btn-primary" data-level="intermediate">
                        @Localizer["Intermediate"]
                    </button>
                </div>
                <p>@Localizer["IntermediateDescription"]</p>
            </div>
            <!--Advanced-->
            <div class="quiz-level-option">
                <div class="quiz-level-action">
                    <svg class="quiz-level-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                        <circle cx="24" cy="24" r="21" fill="#fff2cf" stroke="#976b32" stroke-width="2" />
                        <path d="m9 20 15-8 15 8-15 8-15-8z" fill="#976b32" stroke="#704b20" stroke-width="1.5" stroke-linejoin="round" />
                        <path d="M15 23v8c5 4 13 4 18 0v-8l-9 5z" fill="#c79743" stroke="#704b20" stroke-width="1.3" stroke-linejoin="round" />
                        <path d="M39 20v11m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z" fill="none" stroke="#704b20" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <button type="button" class="btn btn-primary" data-level="advanced">@Localizer["Advanced"]</button>
                </div>
                <p>@Localizer["AdvancedDescription"]</p>
            </div>        
            <!--Expert-->
            <div class="quiz-level-option">
                    <div class="quiz-level-action">
                        <svg class="quiz-level-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                            <circle cx="24" cy="24" r="21" fill="#fff2cf" stroke="#976b32" stroke-width="2" />
                            <path d="M24 8 28 18 39 19 31 27 33 38 24 32 15 38 17 27 9 19 20 18z"
                                  fill="#976b32" stroke="#704b20" stroke-width="1.2"
                                  stroke-linejoin="round" />
                        </svg>
                        <button type="button" class="btn btn-primary" data-level="expert">
                            @Localizer["Expert"]
                        </button>
                    </div>
                    <p>@Localizer["ExpertDescription"]</p>
                </div>
            </div>
        </div>
    <div class="inner certificate-intro m-5">
        <p>@Localizer["QuizIntroduction"]</p>
    </div>

    <!-- Quiz -->
    <section id="quizPanel" class="mx-auto" style="display:none; max-width:640px">
        <p id="quizProgress"></p>
        <p>@Localizer["Correct"]: <span id="quizCorrect">0</span> · @Localizer["Incorrect"]: <span id="quizIncorrect">0</span></p>
        <p>@Localizer["Time"]: <strong id="quizTimer"></strong></p>
        <audio id="quizAudio" controls preload="none" class="w-100"></audio>

        <div class="my-3">
            <p class="form-label">@Localizer["CountLabel"]</p>
            <div id="quizCountButtons"
                 class="quiz-answer-options"
                 role="group"
                 aria-label="@Localizer["CountLabel"]">
            </div>
            <select id="quizCount" class="d-none"></select>
        </div>

        <div class="my-3">
            <p class="form-label">@Localizer["TypeLabel"]</p>
            <div id="quizTypeButtons"
                 class="quiz-answer-options"
                 role="group"
                 aria-label="@Localizer["TypeLabel"]">
            </div>
            <select id="quizType" class="d-none"></select>
        </div>

        <div class="my-3">
            <p class="form-label">@Localizer["QualityLabel"]</p>
            <div id="quizQualityButtons"
                 class="quiz-answer-options"
                 role="group"
                 aria-label="@Localizer["QualityLabel"]">
            </div>
            <select id="quizQuality" class="d-none"></select>
        </div>

        <button id="quizSubmit" type="button" class="btn btn-success">@Localizer["Check"]</button>
        <button id="quizNext" type="button" class="btn btn-primary" style="display:none">@Localizer["NextChord"]</button>
        <p id="quizFeedback" class="mt-3" aria-live="polite"></p>
        <h2 id="quizOutcome" class="mt-4" aria-live="polite" style="display:none"></h2>

        <section id="googleLoginPrompt" class="my-4" style="display:none">
            <p>@Localizer["GoogleLoginPrompt"]</p>
            <a id="googleLoginButton" class="btn btn-outline-primary" href="@Url.Page("/GetCertified", "GoogleLogin", new { returnUrl = Url.Page("/GetCertified") })">@Localizer["GoogleLogin"]</a>
        </section>

        <section id="certificateForm" class="my-4" style="display:none">
            <label for="certificateName" class="form-label">@Localizer["CertificateName"]</label>
            <input id="certificateName" class="form-control mx-auto" style="max-width:320px" maxlength="100" value="@Model.DisplayName" readonly required />
            <small class="form-text">@Localizer["GoogleNameOnly"]</small>
            <button id="generateCertificate" type="button" class="btn btn-success mt-3">@Localizer["GenerateCertificate"]</button>
        </section>

        <section id="certificatePreview" class="certificate-preview" style="display:none">
            <p class="certificate-kicker">@Localizer["CertificateHeading"]</p>
            <h2>@Localizer["CertificateTitle"]</h2>
            <p>@Localizer["CertificateConfirmation"]</p>
            <h1 id="certificateRecipient"></h1>
            <p>@Localizer["CertificatePassedLevel"] <strong id="certificateLevel"></strong></p>
            <p>@Localizer["Score"]: <strong id="certificateScore"></strong></p>
            <p id="certificateDate"></p>
            <p>@Localizer["VerificationNumber"]: <strong id="certificateNumber"></strong></p>
            <a id="certificateVerificationLink" class="d-block mb-3" target="_blank" rel="noopener"></a>
            <img id="certificateQr" class="certificate-qr mb-3" alt="@Localizer["CertificateQrAlt"]" />
            <p class="certificate-website"><a href="https://noty-ua.azurewebsites.net/">https://noty-ua.azurewebsites.net/</a></p>
            <button id="printCertificate" type="button" class="btn btn-outline-primary">@Localizer["PrintCertificate"]</button>
        </section>
    </section>
    <!--Verify Certificate Button-->
    <button type="button" class="btn btn-primary verify-certificate-button mt-3" data-bs-toggle="modal" data-bs-target="#verifyCertificateModal">@Localizer["VerifyCertificate"]</button>
    <!--Certificate-->
    <div class="modal fade" id="verifyCertificateModal" tabindex="-1" aria-labelledby="verifyCertificateModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="verifyCertificateForm">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="verifyCertificateModalTitle">@Localizer["VerifyCertificateTitle"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <label for="certificateLookupNumber" class="form-label">@Localizer["VerificationNumber"]</label>
                        <input id="certificateLookupNumber" class="form-control" inputmode="numeric" autocomplete="off" maxlength="10" pattern="[0-9]{10}" required />
                        <div id="certificateLookupResult" class="mt-3" aria-live="polite"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
                        <button type="submit" class="btn btn-primary verify-certificate-button">@Localizer["VerifyCertificate"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <form id="quizTokenForm" class="d-none">@Html.AntiForgeryToken()</form>
</main>

@section Scripts {
    <script src="~/js/getCertified.js" asp-append-version="true"></script>    
}
<link rel="stylesheet" href="~/css/getCertified.css" asp-append-version="true" />

