@page
@model RecogniseChord.Pages.MelodiesModel
@{
}
<div class="mover">
    <div class="text-center" id="devpage">
        <h1 class="display-4">Інтервали у відомих мелодіях</h1>

        <div class="melodycontainer">

            <!-- МАЛА СЕКУНДА -->
            <h2>Мала секунда</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Fur Elise</h3>
                    <p>Людвіг ван Бетховен</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="230"
                     data-pattern="e'8_dis'8_e'8_dis'8_e'8_h8_d'8_c'8_a2"></div>
            </div>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Гуцулка Ксеня</h3>
                    <p>Українська народна пісня</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="230"
                     data-key="G"
                     data-pattern="h8_ais8_h8_ais8_h4_c'4_h2_a2">
                 </div>
            </div>


            <!-- ВЕЛИКА СЕКУНДА -->
            <h2>Велика секунда</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Вийди вийди сонечко</h3>
                    <p>Українська народна пісня</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="230"
                     data-pattern="a8_a8_g8_g8_a4_e8_e8_a8_a8_g8_g8_a4_e8_e8"></div>
            </div>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Пісня Петрика П'яточкина'</h3>
                    <p>Володимир Бистряков</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="145"
                     data-pattern="r4_d8_d8_d8_d8_d8_d8_e8_d8_r4_r2_r4_d8_d8_d8_d8_d8_d8_e8_d8_"></div>
            </div>


            <!-- МАЛА ТЕРЦІЯ -->
            <h2>Мала терція</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Ой у лузі червона калина</h3>
                    <p>Українська народна пісня</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="230"
                     data-pattern="a4_a4_c'4._a8_h8_c'8_h8_a8_gis4_e4"></div>
            </div>


            <!-- ВЕЛИКА ТЕРЦІЯ -->
            <h2>Велика терція</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Ой ходить сон</h3>
                    <p>Українська народна пісня</p>
                </div>
                <div class="melody-notation"
                     data-key="G"
                     data-numerator="3"
                     data-barwidth="120"
                     data-pattern="h4_h4_g4_h2._a4_a4_e4_g2."></div>
            </div>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>When the Saints Go Marching In</h3>
                    <p>Спірічуелс</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="120"
                     data-pattern="r4_c4_e4_f4_g1_r4_c4_e4_f4_g1"></div>
            </div>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Harry Potter theme 2</h3>
                    <p>Nicholas Hooper</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="100"
                     data-numerator="3"
                     data-pattern="r2_c4_e2_c4_e2_c4_f2_e4_dis2_dis4_e4._c8_a,4"></div>
            </div>


            <!-- ЧИСТА КВАРТА -->
            <h2>Чиста кварта</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Ой на горі та й женці жнуть</h3>
                    <p>Українська народна пісня</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="240"
                     data-pattern="a4_e4_g8_f8_e8_d8_c8_d8_e4_a4"></div>
            </div>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Ой Марічко, Чичері</h3>
                    <p>Українська народна пісня</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="240"
                     data-pattern="a8_a8_e8_e8_a8_a4_e8_a8_h8_c'8_h8_a4_g4"></div>
            </div>


            <div class="melody-card">
                <div class="melody-info">
                    <h3>Увертюра до опери «Тарас Бульба»</h3>
                    <p>Микола Лисенко</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="180"
                     data-pattern="r2_r4._e8_a4._e8_g4._c8_f4._d8_e4."></div>
            </div>



            <!-- ТРИТОН -->
            <h2>Тритон</h2>

            <div class="melody-card" data-audio="sound/s8crryce.mp3">
                <div class="melody-info">
                    <h3>Prélude à l'après-midi d'un faune</h3>
                    <p>Claude Debussi</p>
                </div>

                <div class="melodyexample">
                    <img src="https://upload.wikimedia.org/score/s/8/s8crrycesbyym1mol7uphf5o9efbgf9/s8crryce.svg" alt="Debussi." />
                </div>
            </div>


            <!-- ЧИСТА КВІНТА -->
            <h2>Чиста квінта</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Twinkle, Twinkle, Little Star</h3>
                    <p>народна</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="120"
                     data-pattern="c4_c4_g4_g4_a4_a4_g2_f4_f4_e4_e4_d4_d4_c2"></div>
            </div>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Бандуристе, орле сизий</h3>
                    <p>Українська народна пісня</p>
                </div><div class="melody-notation"
                           data-key="F"
                     data-barwidth="240"
                     data-pattern="d4_a4_a4._c'8_b8_a8_g8_b8_a4_a4"></div>
            </div>


            <!-- МАЛА СЕКСТА -->
            <h2>Мала секста</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Ой на горі два дубки</h3>
                    <p>Українська народна пісня</p>
                </div>
                <div class="melody-notation"
                     data-key="Bb"
                     data-barwidth="240"
                     data-pattern="d8_d8_d8_d8_b4_a4_g2"></div>
            </div>

            <!-- ВЕЛИКА СЕКСТА -->
            <h2>Велика секста</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Україна</h3>
                    <p>Тарас Петриненко</p>
                </div>
                <div class="melody-notation"
                     data-key="F"
                     data-pattern="r2._r8_c8_a4._a8_a8_b8_g8_e8_f8_c4."></div>
            </div>



            <!-- МАЛА СЕПТИМА -->
            <h2>Мала септима</h2>


            <div class="melody-card">
                <div class="melody-info">
                    <h3>Ой на плаю</h3>
                    <p>Українська народна пісня</p>
                </div>
                <div class="melody-notation"
                     data-key="F"
                     data-numerator="6"
                     data-pattern="c4_c4_c4_b2._b4_a8_c'8_b4_g4_g2"></div>
            </div>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>"Тепер я турок не козак""</h3>
                    <p>С.Гулак-Артемовський (арія Уарася з опери "Запорожець за Дунаєм")</p>
                </div>
                <div class="melody-notation"
                     data-key="F"
                     data-pattern="r2_r4._c8_b4._a8_g8_f8_e8_d8_c4"></div>
            </div>


            <!-- ВЕЛИКА СЕПТИМА -->
            <h2>Велика септима</h2>


            <!-- ОКТАВА -->
            <h2>Октава</h2>

            <div class="melody-card">
                <div class="melody-info">
                    <h3>Somewhere Over the Rainbow</h3>
                    <p>Гарольд Арлен</p>
                </div>
                <div class="melody-notation"
                     data-barwidth="240"
                     data-pattern="c2_c'2_h4_g8_a8_h4_c'4"></div>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/midirender/vexflow.js"></script>
    <script src="~/lib/midirender/melodyAudio.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-beams-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-key-signatures-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-calculate-rows-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-svg-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/midiRenderer.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/midiparser_ext.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/patternRenderer.js"
            asp-append-version="true"></script>
    <script src="~/js/melodies.js"
            asp-append-version="true"></script>
}
