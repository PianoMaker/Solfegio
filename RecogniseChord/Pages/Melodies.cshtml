@page
@model RecogniseChord.Pages.MelodiesModel
@{
    ViewData["Title"] = Localizer["PageTitle"];
}
<div class="mover">
    <div class="text-center" id="devpage" data-play-label="@Localizer["Play"]" data-stop-label="@Localizer["Stop"]" data-play-aria="@Localizer["PlayMelody"]" data-stop-aria="@Localizer["StopPlayback"]">
        <h1 class="display-4">@Localizer["PageTitle"]</h1>

        <div class="melodycontainer">

            <!-- МАЛА СЕКУНДА -->
            <div class="interval-section dissonant" id="minsecond">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="minsecond-content">@Localizer["MinorSecond"]</button></h2><img src="~/images/intervals/minor-second.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="minsecond-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["FurElise"]</h3>
                            <p>@Localizer["Beethoven"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="230"
                             data-pattern="e'8_dis'8_e'8_dis'8_e'8_h8_d'8_c'8_a2"></div>
                    </div>

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["HutsulkaKsenia"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="230"
                             data-key="G"
                             data-pattern="h8_ais8_h8_ais8_h4_c'4_h2_a2">
                        </div>
                    </div>
                </div>
            </div>

            <!-- ВЕЛИКА СЕКУНДА -->
            <div class="interval-section dissonant" id="majorsecond">
                <div class="interval-heading-with-keyboard-between">
                    <h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="majorsecond-content">@Localizer["MajorSecond"]</button></h2>
                    <img src="~/images/intervals/major-second.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" />
                </div>
                <div class="interval-content" id="majorsecond-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["SunshineComeOut"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="230"
                             data-pattern="a8_a8_g8_g8_a4_e8_e8_a8_a8_g8_g8_a4_e8_e8"></div>
                    </div>

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["PetrykPyatochkinSong"]</h3>
                            <p>@Localizer["VolodymyrBistryakov"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="145"
                             data-pattern="r4_d8_d8_d8_d8_d8_d8_e8_d8_r4_r2_r4_d8_d8_d8_d8_d8_d8_e8_d8_"></div>
                    </div>


                    <!-- МАЛА ТЕРЦІЯ -->
                </div>
            </div>
            <div class="interval-section consonant" id="minorthird">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="minorthird-content">@Localizer["MinorThird"]</button></h2><img src="~/images/intervals/minor-third.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="minorthird-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["RedViburnumSong"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="230"
                             data-pattern="a4_a4_c'4._a8_h8_c'8_h8_a8_gis4_e4"></div>
                    </div>


                    <!-- ВЕЛИКА ТЕРЦІЯ -->
                </div>
            </div>
            <div class="interval-section consonant" id="majorthird">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="majorthird-content">@Localizer["MajorThird"]</button></h2><img src="~/images/intervals/major-third.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="majorthird-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["SleepWalksSong"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-key="G"
                             data-numerator="3"
                             data-barwidth="120"
                             data-pattern="h4_h4_g4_h2._a4_a4_e4_g2."></div>
                    </div>

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["WhenTheSaints"]</h3>
                            <p>@Localizer["Spiritual"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="120"
                             data-pattern="r4_c4_e4_f4_g1_r4_c4_e4_f4_g1"></div>
                    </div>

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["HarryPotterTheme"]</h3>
                            <p>@Localizer["NicholasHooper"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="100"
                             data-numerator="3"
                             data-pattern="r2_c4_e2_c4_e2_c4_f2_e4_dis2_dis4_e4._c8_a,4"></div>
                    </div>


                    <!-- ЧИСТА КВАРТА -->
                </div>
            </div>
            <div class="interval-section consonant" id="perfectfourth">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="perfectfourth-content">@Localizer["PerfectFourth"]</button></h2><img src="~/images/intervals/perfect-fourth.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="perfectfourth-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["OyNaHori"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="240"
                             data-pattern="a4_e4_g8_f8_e8_d8_c8_d8_e4_a4"></div>
                    </div>

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["OyMarichko"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="240"
                             data-pattern="a8_a8_e8_e8_a8_a4_e8_a8_h8_c'8_h8_a4_g4"></div>
                    </div>


                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["TarasBulbaOverture"]</h3>
                            <p>@Localizer["MykolaLysenko"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="180"
                             data-pattern="r2_r4._e8_a4._e8_g4._c8_f4._d8_e4."></div>
                    </div>



                    <!-- ТРИТОН -->
                </div>
            </div>
            <div class="interval-section dissonant" id="tritone">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="tritone-content">@Localizer["Tritone"]</button></h2><img src="~/images/intervals/tritone.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="tritone-content">

                    <div class="melody-card" data-audio="/samplesound/s8crryce.mp3">
                        <div class="melody-info">
                            <h3>Prélude à l'après-midi d'un faune</h3>
                            <p>@Localizer["ClaudeDebussy"]</p>
                        </div>

                        <div class="melodyexample">
                            <img src="https://upload.wikimedia.org/score/s/8/s8crrycesbyym1mol7uphf5o9efbgf9/s8crryce.svg" alt="@Localizer["DebussyScoreAlt"]" />
                        </div>
                    </div>


                    <!-- ЧИСТА КВІНТА -->
                </div>
            </div>
            <div class="interval-section consonant" id="perfectfifth">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="perfectfifth-content">@Localizer["PerfectFifth"]</button></h2><img src="~/images/intervals/perfect-fifth.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="perfectfifth-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["TwinkleTwinkle"]</h3>
                            <p>@Localizer["FolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="120"
                             data-pattern="c4_c4_g4_g4_a4_a4_g2_f4_f4_e4_e4_d4_d4_c2"></div>
                    </div>

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["Banduryste"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div><div class="melody-notation"
                                   data-key="F"
                                   data-barwidth="240"
                                   data-pattern="d4_a4_a4._c'8_b8_a8_g8_b8_a4_a4"></div>
                    </div>


                    <!-- МАЛА СЕКСТА -->
                </div>
            </div>
            <div class="interval-section consonant" id="minorsixth">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="minorsixth-content">@Localizer["MinorSixth"]</button></h2><img src="~/images/intervals/minor-sixth.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="minorsixth-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["TwoOakTrees"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-key="Bb"
                             data-barwidth="240"
                             data-pattern="d8_d8_d8_d8_b4_a4_g2"></div>
                    </div>

                    <!-- ВЕЛИКА СЕКСТА -->
                </div>
            </div>
            <div class="interval-section consonant" id="majorsixth">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="majorsixth-content">@Localizer["MajorSixth"]</button></h2><img src="~/images/intervals/major-sixth.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="majorsixth-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["UkraineSong"]</h3>
                            <p>@Localizer["TarasPetrynenko"]</p>
                        </div>
                        <div class="melody-notation"
                             data-key="F"
                             data-pattern="r2._r8_c8_a4._a8_a8_b8_g8_e8_f8_c4."></div>
                    </div>



                    <!-- МАЛА СЕПТИМА -->
                </div>
            </div>
            <div class="interval-section dissonant" id="minorseventh">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="minorseventh-content">@Localizer["MinorSeventh"]</button></h2><img src="~/images/intervals/minor-seventh.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="minorseventh-content">


                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["OyNaPlayu"]</h3>
                            <p>@Localizer["UkrainianFolkSong"]</p>
                        </div>
                        <div class="melody-notation"
                             data-key="F"
                             data-numerator="6"
                             data-pattern="c4_c4_c4_b2._b4_a8_c'8_b4_g4_g2"></div>
                    </div>

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["TurkNotCossack"]</h3>
                            <p>@Localizer["HulakArtemovskyCredit"]</p>
                        </div>
                        <div class="melody-notation"
                             data-key="F"
                             data-pattern="r2_r4._c8_b4._a8_g8_f8_e8_d8_c4"></div>
                    </div>


                    <!-- ВЕЛИКА СЕПТИМА -->
                </div>
            </div>
            <div class="interval-section dissonant" id="majorseventh">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="majorseventh-content">@Localizer["MajorSeventh"]</button></h2><img src="~/images/intervals/major-seventh.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:4em" /></div>
                <div class="interval-content" id="majorseventh-content">


                    <!-- ОКТАВА -->
                </div>
            </div>
            <div class="interval-section consonant" id="octave">
                <div class="interval-heading-with-keyboard-between"><h2><button type="button" class="interval-toggle" aria-expanded="false" aria-controls="octave-content">@Localizer["Octave"]</button></h2><img src="~/images/intervals/octave.svg" alt="@Localizer["PianoKeyboardInterval"]" style="height:3.5em" /></div>
                <div class="interval-content" id="octave-content">

                    <div class="melody-card">
                        <div class="melody-info">
                            <h3>@Localizer["SomewhereOverRainbow"]</h3>
                            <p>@Localizer["HaroldArlen"]</p>
                        </div>
                        <div class="melody-notation"
                             data-barwidth="240"
                             data-pattern="c2_c'2_h4_g8_a8_h4_c'4"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/midirender/vexflow.js"></script>
    <script src="~/lib/midirender/melodyAudio.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-beams-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-key-signatures-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/vexflow_ext.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/midiRenderer.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/midiparser_ext.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/patternRenderer.js"
            asp-append-version="true"></script>
    <script src="~/js/melodies.js"
            asp-append-version="true"></script>
}
