@page
@model RecogniseChord.Pages.MelodiesModel
@{
}
<div class="text-center" id="devpage">
    <h1 class="display-4">Інтервали у відомих мелодіях</h1>

    <div class="melodycontainer">

        <!-- МАЛА СЕКУНДА -->
        <h2>Мала секунда</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Jaws</h3>
                <p>Джон Вільямс</p>
            </div>
            <div class="melody-notation"
                 data-pattern="e4_f4_e4_f4_e4_f4_e4_f4"></div>
        </div>


        <!-- ВЕЛИКА СЕКУНДА -->
        <h2>Велика секунда</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Happy Birthday</h3>
                <p>Патті та Мілдред Хілл</p>
            </div>
            <div class="melody-notation"
                 data-pattern="g4_g4_a4_g4_c'4_h2_"></div>
        </div>


        <!-- МАЛА ТЕРЦІЯ -->
        <h2>Мала терція</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Greensleeves</h3>
                <p>народна</p>
            </div>
            <div class="melody-notation"
                 data-pattern="a4_c'4_d'4_e'4_f'4_e'4_d'4_c'4"></div>
        </div>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Ой у лузі червона калина</h3>
                <p>українська народна</p>
            </div>
            <div class="melody-notation"
                 data-pattern="a4_a4_c'4._a8_h8_c'8_h8_a8_gis4_e4"></div>
        </div>


        <!-- ВЕЛИКА ТЕРЦІЯ -->
        <h2>Велика терція</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>When the Saints Go Marching In</h3>
                <p>народна</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c4_e4_f4_g4_c4_e4_f4_g4"></div>
        </div>


        <!-- ЧИСТА КВАРТА -->
        <h2>Чиста кварта</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Here Comes the Bride</h3>
                <p>Ріхард Вагнер</p>
            </div>
            <div class="melody-notation"
                 data-pattern="g4_g4_d'4_h4_g4_g4_d'4_h4"></div>
        </div>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Ой на горі та й женці жнуть</h3>
                <p>народна</p>
            </div>
            <div class="melody-notation"
                 data-pattern="a4_e4_g8_f8_e8_d8_c8_d8_e4_a4"></div>
        </div>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Увертюра до опери «Тарас Бульба»</h3>
                <p>Микола Лисенко</p>
                <div class="melody-notation"
                     data-pattern="r2_r4._e8_a4._e8_g4._c8_f4._d8_e4."></div>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>


        <!-- ТРИТОН -->
        <h2>Тритон</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>The Simpsons</h3>
                <p>Денні Ельфман</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c4_fs4_f4_h4_fs4_c4"></div>
        </div>


        <!-- ЧИСТА КВІНТА -->
        <h2>Чиста квінта</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Star Wars</h3>
                <p>Джон Вільямс</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c4_g4_f4_c'4_g4_f4_c'4">
             </div>
        </div>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Twinkle, Twinkle, Little Star</h3>
                <p>народна</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>


        <!-- ВЕЛИКА СЕКСТА -->
        <h2>Велика секста</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>My Bonnie Lies Over the Ocean</h3>
                <p>народна</p>
            </div>
            <div class="melody-notation"
                 data-pattern="g4_e'4_d'4_c'4_d'4_e'4_d'4"></div>
        </div>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Україна</h3>
                <p>Тарас Петриненко</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Ой на горі два дубки</h3>
                <p>народна</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>


        <!-- МАЛА СЕПТИМА -->
        <h2>Мала септима</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Somewhere</h3>
                <p>Леонард Бернстайн</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c'4_b4_a4_g4_f4_e4_d4_c4"></div>
        </div>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Ой на плаю</h2>
                <p>народна</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>


        <!-- ВЕЛИКА СЕПТИМА -->
        <h2>Велика септима</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Take On Me</h3>
                <p>a-ha</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c'4_h4_a4_g4_a4_h4_c'4"></div>
        </div>


        <!-- ОКТАВА -->
        <h2>Октава</h2>

        <div class="melody-card">
            <div class="melody-info">
                <h3>Somewhere Over the Rainbow</h3>
                <p>Гарольд Арлен</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c4_c'4_h4_a4_g4_f4_e4_d4"></div>
        </div>

    </div>
</div>
@section Scripts {
    <script src="~/lib/midirender/vexflow.js"></script>
    <script src="~/lib/midirender/mr-beams-helper.js"></script>
    <script src="~/lib/midirender/mr-calculate-rows-helper.js"></script>
    <script src="~/lib/midirender/midiRenderer.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/midiparser_ext.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/patternRenderer.js"
            asp-append-version="true"></script>
    <script src="~/js/melodies.js"
            asp-append-version="true"></script>
}
