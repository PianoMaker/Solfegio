@page
@model RecogniseChord.Pages.MelodiesModel
@{
}
<div class="text-center" id="devpage">
    <h1 class="display-4">Інтервали у відомих мелодіях</h1>

    <div class="melodycontainer">

        <!-- МАЛА СЕКУНДА -->
        <h2>Мала секунда</h2>
        <p>Jaws — Джон Вільямс</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Jaws</h2>
                <p>Мала секунда</p>
            </div>
            <div class="melody-notation"
                 data-pattern="e4_f4_e4_f4_e4_f4_e4_f4"></div>
        </div>


        <!-- ВЕЛИКА СЕКУНДА -->
        <h2>Велика секунда</h2>
        <p>Happy Birthday — Патті та Мілдред Хілл</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Happy Birthday</h2>
                <p>Велика секунда</p>
            </div>
            <div class="melody-notation"
                 data-pattern="g4_g4_a4_g4_c'4_h2_"></div>
        </div>


        <!-- МАЛА ТЕРЦІЯ -->
        <h2>Мала терція</h2>
        <p>Greensleeves — народна</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Greensleeves</h2>
                <p>Мала терція</p>
            </div>
            <div class="melody-notation"
                 data-pattern="a4_c'4_d'4_e'4_f'4_e'4_d'4_c'4"></div>
        </div>

        <p>«Ой у лузі червона калина» — Степан Чарнецький, народна мелодія</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Ой у лузі червона калина</h2>
                <p>Мала терція</p>
            </div>
            <div class="melody-notation"
                 data-pattern="a4_c'4_d'4_e'4_f'4_e'4_d'4_c'4"></div>
        </div>


        <!-- ВЕЛИКА ТЕРЦІЯ -->
        <h2>Велика терція</h2>
        <p>When the Saints Go Marching In — народна</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>When the Saints Go Marching In</h2>
                <p>Велика терція</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c4_e4_f4_g4_c4_e4_f4_g4"></div>
        </div>


        <!-- ЧИСТА КВАРТА -->
        <h2>Чиста кварта</h2>
        <p>Here Comes the Bride — Ріхард Вагнер</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Here Comes the Bride</h2>
                <p>Чиста кварта</p>
            </div>
            <div class="melody-notation"
                 data-pattern="g4_g4_d'4_h4_g4_g4_d'4_h4"></div>
        </div>

        <p>«Ой на горі та й женці жнуть» — народна</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Ой на горі та й женці жнуть</h2>
                <p>Чиста кварта</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>

        <p>«Тарас Бульба» — Микола Лисенко</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Увертюра до опери «Тарас Бульба»</h2>
                <p>Чиста кварта</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>


        <!-- ТРИТОН -->
        <h2>Тритон</h2>
        <p>The Simpsons — Денні Ельфман</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>The Simpsons</h2>
                <p>Тритон</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c4_fs4_f4_h4_fs4_c4"></div>
        </div>


        <!-- ЧИСТА КВІНТА -->
        <h2>Чиста квінта</h2>
        <p>Star Wars — Джон Вільямс</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Star Wars</h2>
                <p>Чиста квінта</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c4_g4_f4_c'4_g4_f4_c'4"></div>
        </div>

        <p>Twinkle, Twinkle, Little Star — народна</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Twinkle, Twinkle, Little Star</h2>
                <p>Чиста квінта</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>


        <!-- ВЕЛИКА СЕКСТА -->
        <h2>Велика секста</h2>
        <p>My Bonnie Lies Over the Ocean — народна</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>My Bonnie Lies Over the Ocean</h2>
                <p>Велика секста</p>
            </div>
            <div class="melody-notation"
                 data-pattern="g4_e'4_d'4_c'4_d'4_e'4_d'4"></div>
        </div>

        <p>«Україна» — Тарас Петриненко</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Україна</h2>
                <p>Велика секста</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>

        <p>«Ой на горі два дубки» — народна</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Ой на горі два дубки</h2>
                <p>Велика секста</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>


        <!-- МАЛА СЕПТИМА -->
        <h2>Мала септима</h2>        

        <div class="melody-card">
            <div class="melody-info">
                <h2>Somewhere</h2>
                <p>Мала септима</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c'4_b4_a4_g4_f4_e4_d4_c4"></div>
        </div>

        <p>«Ой на плаю» — народна</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Ой на плаю</h2>
                <p>Мала септима</p>
            </div>
            <div class="melody-notation"
                 data-pattern=""></div>
        </div>


        <!-- ВЕЛИКА СЕПТИМА -->
        <h2>Велика септима</h2>
        <p>Take On Me — a-ha</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Take On Me</h2>
                <p>Велика септима</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c'4_h4_a4_g4_a4_h4_c'4"></div>
        </div>


        <!-- ОКТАВА -->
        <h2>Октава</h2>
        <p>Somewhere Over the Rainbow — Гарольд Арлен</p>

        <div class="melody-card">
            <div class="melody-info">
                <h2>Somewhere Over the Rainbow</h2>
                <p>Октава</p>
            </div>
            <div class="melody-notation"
                 data-pattern="c4_c'4_h4_a4_g4_f4_e4_d4"></div>
        </div>

    </div>
</div>
@section Scripts {
    <script src="~/lib/midirender/vexflow.js"></script>
    <script src="~/lib/midirender/mr-beams-helper.js"></script>
    <script src="~/lib/midirender/mr-calculate-rows-helper.js"></script>
    <script src="~/lib/midirender/midiRenderer.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/midiparser_ext.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/patternRenderer.js"
            asp-append-version="true"></script>
    <script src="~/js/melodies.js"
            asp-append-version="true"></script>
}
