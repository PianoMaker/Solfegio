@page
@model CreateModel
@{
    ViewData["Title"] = Localizer["BuildChord"];
}

<div class="text-center">
    <h1 class="display-4">@Localizer["BuildChord"]</h1>
    <div class="innercontainer">
        <div id="rightcontainer" class="halfcontainer">
            <form method="post" asp-page-handler="Count" id="countForm">
                <p>@Localizer["CountQuestion"]</p>
                @foreach (var c in Model.CountOptions)
                {
                    if (Model.SelectedCount.ToString() == c)
                    {
                        @:<label class="me-2"><input type="radio" name="SelectedCount" value="@c" checked /> @c</label>
                    }
                    else
                    {
                        @:<label class="me-2"><input type="radio" name="SelectedCount" value="@c" /> @c</label>
                    }
                }
                <input type="hidden" asp-for="RootNote" />
            </form>

            <!-- Інтервал/Акорд -->
            <form method="post" asp-page-handler="Type" id="typeForm">
                <div class="mt-3">
                    <label>@Localizer["Type"]</label>
                    <select asp-for="SelectedType" id="SelectedType" class="select-chord" onchange="document.getElementById('typeForm')?.submit();">
                        <option value="">--</option>
                        @foreach (var t in Model.TypeOptions)
                        {
                            <option value="@t">@Localizer[t]</option>
                        }
                    </select>
                </div>
                <input type="hidden" asp-for="SelectedCount" />
                <input type="hidden" asp-for="RootNote" />
            </form>

            <!-- Якість  -->
            <form method="post" asp-page-handler="Quality" id="qualityForm">
                <div class="mt-3">
                    <label>@Localizer["Quality"]</label>
                    @{
                        var displayCount = Model.SelectedCount;
                    }
                    <select asp-for="SelectedQuality" id="SelectedQuality" class="select-chord" onchange="document.getElementById('qualityForm')?.submit();">
                        <option value="">--</option>
                        @foreach (var q in Model.QualityOptions)
                        {
                            <option value="@q" selected="@(Model.SelectedQuality == q ? "selected" : null)">@q</option>
                        }
                    </select>
                </div>

                <!-- ТОНАЛЬНІСТЬ -->
                <div class="mt-3">
                    <label>@Localizer["RootNote"]</label>
                    <select asp-for="RootNote" class="select-root" onchange="document.getElementById('qualityForm')?.submit();">
                        @foreach (var r in Model.RootOptions)
                        {
                            if (Model.RootNote == r)
                            {
                                @:
                                <option value="@r" selected>@r</option>
                            }
                            else
                            {
                                @:
                                <option value="@r">@r</option>
                            }
                        }
                    </select>
                </div>
                <input type="hidden" asp-for="SelectedCount" />
                <input type="hidden" asp-for="SelectedType" />
                <input type="hidden" asp-for="Timbre" />
            </form>

            <!-- ТЕМБР -->
            <div>
                <form id="timbreform" method="post" asp-page-handler="timbre">
                    <p>@Localizer["ChooseTimbre"]</p>
                    <div style="display:block; margin:5px">
                        <select asp-for="Timbre" id="SelectedTimbre" class="select-chord">
                            @foreach (var timbre in Model.AllTimbres)
                            {
                                <option value="@timbre" selected="@(Model.Timbre == timbre)">@timbre</option>
                            }
                        </select>                        
                    </div>
                    <input type="hidden" asp-for="SelectedCount" />
                    <input type="hidden" asp-for="SelectedType" />
                    <input type="hidden" asp-for="RootNote" />
                </form>
            </div>

            <!-- ГРАТИ -->
            <div class="mt-4">
                <button id="playBtn" type="button" class="btn btn-success">@Localizer["Play"]</button>
                <audio id="chordAudio" preload="auto"></audio>
                <input type="hidden" id="generatedRel" value="@Model.GeneratedFileRelative" />
            </div>

            <!--НОТИ-->
            <div class="mt-4 d-flex">
                <div class="chordbox">
                    <div id="notecontainer"
                         data-barwidth="180"
                         data-pattern="@Model.ChordCode">
                    </div>
                </div>
            </div>
        </div>
        <div id="leftcontainer" class="halfcontainer">
            @if (Model.CanPlay)
            {
                <!--<p>Файл створено: <code>@Model.GeneratedFileRelative</code></p>-->
                <p>Акорд: @Localizer[Model.SelectedType] @Model.SelectedQuality (@Model.RootNote)</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/midirender/vexflow.js"></script>
    <script src="~/lib/midirender/melodyAudio.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-beams-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-key-signatures-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-calculate-rows-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/mr-svg-helper.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/midiRenderer.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/midiparser_ext.js" asp-append-version="true"></script>
    <script src="~/lib/midirender/patternRenderer.js"
            asp-append-version="true"></script>
    <script src="~/js/create.js" asp-append-version="true"></script>
}
